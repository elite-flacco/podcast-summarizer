{
  "name": "pod-worker",
  "version": "1.0.0",
  "description": "Standalone worker to sync YouTube podcasts to Google Docs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"**/*.md\""
  },
  "keywords": [
    "youtube",
    "podcasts",
    "ai",
    "summaries",
    "google-docs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.9",
    "google-auth-library": "^11.3.3",
    "googleapis": "^188.0.0",
    "openai": "^7.53.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "prettier": "^3.9.10",
    "ts-node": "^10",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
